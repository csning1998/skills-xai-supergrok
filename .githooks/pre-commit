#!/bin/sh
# Blocks commits containing detected secrets using the official gitleaks image.
# Activation: git config core.hooksPath .githooks

set -e

IMAGE="docker.io/zricethezav/gitleaks:v8.30.1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# ~/.grok is user_home_t. GitLab checkouts are already container_file_t.
chcon -t container_file_t -R "${REPO_ROOT}/.git"

podman run --rm \
    -v "${REPO_ROOT}/.git:/repo/.git:ro" \
    -w /repo \
    -e GIT_DIR=/repo/.git \
    -e GIT_WORK_TREE=/repo \
    "$IMAGE" \
    protect --staged --redact -v
