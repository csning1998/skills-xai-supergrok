#!/bin/sh
# Validates commit messages against Conventional Commits using reviewer:1.6.0.
# Activation: git config core.hooksPath .githooks

set -e

IMAGE="registry.gitlab.com/csning1998/gitlab-ci-with-code-reviewer/reviewer:1.6.0"
MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# ~/.grok is user_home_t. GitLab checkouts are already container_file_t.
chcon -t container_file_t -R "${REPO_ROOT}/.git"

podman run --rm \
    -v "${REPO_ROOT}/.git:/repo/.git:ro" \
    -v "$(realpath "${MSG_FILE}"):/repo/COMMIT_EDITMSG:ro" \
    -w /repo \
    "$IMAGE" \
    commitlint --config /etc/commitlint/commitlint.config.cjs \
    --cwd /repo --edit /repo/COMMIT_EDITMSG
